{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Codex Plugin Manifest",
  "description": "Schema for .codex-plugin/plugin.json based on the current OpenAI plugin manifest contract.",
  "type": "object",
  "required": [
    "name",
    "version",
    "description",
    "author",
    "interface"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "description": { "type": "string", "minLength": 1 },
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
    "repository": { "type": "string", "format": "uri", "pattern": "^https://" },
    "license": { "type": "string", "minLength": 1 },
    "keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "skills": { "type": "string", "pattern": "^\\./" },
    "apps": { "type": "string", "pattern": "^\\./" },
    "mcpServers": {
      "oneOf": [
        { "type": "string", "pattern": "^\\./" },
        { "type": "object" }
      ]
    },
    "interface": {
      "$ref": "#/$defs/interface"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "com.openai": { "$ref": "#/$defs/openai" }
      }
    }
  },
  "$defs": {
    "openai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onboardingSkill": { "type": "string", "pattern": "^\\./skills/.+/SKILL\\.md$" },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "test_cases": {
              "type": "object",
              "additionalProperties": false,
              "required": ["positive", "negative"],
              "properties": {
                "positive": {
                  "type": "array",
                  "minItems": 5,
                  "maxItems": 5,
                  "items": { "$ref": "#/$defs/positiveTestCase" }
                },
                "negative": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": { "$ref": "#/$defs/negativeTestCase" }
                }
              }
            },
            "demo_recording_url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "commerce": { "type": "boolean" },
            "commerce_description": { "type": "string", "minLength": 1 }
          }
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "countries": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[A-Z]{2}$" },
              "uniqueItems": true
            },
            "release_notes": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "positiveTestCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "prompt", "tools_triggered", "expected_behavior"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "prompt": { "type": "string", "minLength": 1 },
        "tools_triggered": { "type": "string", "minLength": 1 },
        "expected_behavior": { "type": "string", "minLength": 1 },
        "file_attachment_urls": {
          "type": "array",
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "expected_output_url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "negativeTestCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "prompt"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 }
      }
    },
    "interface": {
      "type": "object",
      "required": [
        "displayName",
        "shortDescription",
        "longDescription",
        "developerName",
        "category",
        "capabilities",
        "defaultPrompt"
      ],
      "additionalProperties": false,
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 30 },
        "shortDescription": { "type": "string", "minLength": 1, "maxLength": 30 },
        "longDescription": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "developerName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "websiteURL": { "type": "string", "format": "uri", "pattern": "^https://" },
        "supportURL": { "type": "string", "format": "uri", "pattern": "^https://" },
        "privacyPolicyURL": { "type": "string", "format": "uri", "pattern": "^https://" },
        "termsOfServiceURL": { "type": "string", "format": "uri", "pattern": "^https://" },
        "defaultPrompt": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 128 },
          "minItems": 1,
          "maxItems": 3
        },
        "default_prompt": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 128 },
          "minItems": 1,
          "maxItems": 3
        },
        "brandColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "composerIcon": { "type": "string", "pattern": "^\\./assets/" },
        "logo": { "type": "string", "pattern": "^\\./assets/" },
        "logoDark": { "type": "string", "pattern": "^\\./assets/" },
        "screenshots": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\./assets/.+\\.png$" }
        }
      }
    }
  }
}
