{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Codex Plugin Marketplace",
  "description": "Schema for .agents/plugins/marketplace.json based on the current OpenAI marketplace contract.",
  "type": "object",
  "required": ["name", "plugins"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": { "type": "string", "minLength": 1 }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "source", "policy", "category"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
          },
          "source": {
            "type": "object",
            "required": ["source", "path"],
            "additionalProperties": false,
            "properties": {
              "source": { "const": "local" },
              "path": { "type": "string", "pattern": "^\\./" }
            }
          },
          "policy": {
            "type": "object",
            "required": ["installation", "authentication"],
            "additionalProperties": false,
            "properties": {
              "installation": {
                "enum": ["NOT_AVAILABLE", "AVAILABLE", "INSTALLED_BY_DEFAULT"]
              },
              "authentication": {
                "enum": ["ON_INSTALL", "ON_USE"]
              },
              "products": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              }
            }
          },
          "category": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
